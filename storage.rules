rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/polaroids/{file} {
      allow read: if true;
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
