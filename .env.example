# Optional. If these are set, the app uses them. If not, the app fetches its
# Firebase config from Firebase Hosting at /__/firebase/init.json, which
# works automatically once you deploy with `firebase deploy`.
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Set to "true" to talk to the local Firebase emulators (npm run emulators).
# VITE_USE_EMULATORS=true
